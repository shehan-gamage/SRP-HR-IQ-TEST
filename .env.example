# Copy to .env.local and set real values. Never commit .env.local.

# Password for the shared HR administration account.
ADMIN_PASSWORD=change-me-to-something-long

# Signing key for the admin session cookie. At least 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Where the local SQLite file lives. Back this up: it holds every candidate
# record. Used only when TURSO_DATABASE_URL is unset.
DB_PATH=./data/hriq.sqlite

# ── Hosted database (required on Vercel/serverless, optional elsewhere) ──
# Create a database at https://turso.tech, then paste its libsql URL and an
# auth token here. When set, the app uses Turso instead of the local file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set to 1 only when serving over HTTPS, so the session cookie is marked Secure.
COOKIE_SECURE=0

# Timezone for all human-facing timestamps (dashboard, receipt, emails).
# Servers often run in UTC; this keeps wall-clock times local to the business.
TIME_ZONE=Asia/Colombo

# ── Invite email delivery (optional) ──
# Leave SMTP_USER/SMTP_PASS unset to disable sending; invites can still be
# created and their links copied manually.
# Google Workspace: authenticate as a real mailbox with a 16-char App Password
# (requires 2-Step Verification on that account). MAIL_FROM may differ from
# SMTP_USER only if the account has "Send mail as" rights for it.
# If local antivirus (e.g. Avast Mail Shield) intercepts port 465 and breaks
# TLS verification, use SMTP_PORT=587 with SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: CC every invite email to this address (e.g. an HR coordinator).
MAIL_CC=
